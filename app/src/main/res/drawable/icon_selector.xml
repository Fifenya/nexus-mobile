<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bgTertiary"/>
            <stroke android:width="2dp" android:color="@color/accent"/>
            <corners android:radius="@dimen/radius_lg"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bgTertiary"/>
            <stroke android:width="3dp" android:color="@color/accent"/>
            <corners android:radius="@dimen/radius_lg"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bgSecondary"/>
            <stroke android:width="1dp" android:color="@color/border"/>
            <corners android:radius="@dimen/radius_lg"/>
        </shape>
    </item>
</selector>
