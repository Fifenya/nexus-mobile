<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Nexus"
        android:theme="@style/NexusTheme"
        android:usesCleartextTraffic="true">
        
        <activity android:name=".MainActivity" android:exported="true" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".ChatsActivity" />
        <activity android:name=".ChatActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".BotsActivity" />
        <activity android:name=".IconPickerActivity" />

        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@drawable/icon_default"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityNeon"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name_neon"
            android:icon="@drawable/icon_neon"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityGold"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name_gold"
            android:icon="@drawable/icon_gold"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMono"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name_mono"
            android:icon="@drawable/icon_mono"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
